# ========================================
# 生产环境配置
# ========================================

# 应用配置
NODE_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# 服务端口
FRONTEND_PORT=80
BACKEND_PORT=8000

# 数据库配置（生产环境使用PostgreSQL）
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/social_trends
REDIS_URL=redis://redis:6379

# API URLs（需要替换为实际域名）
REACT_APP_API_URL=https://api.yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# JWT配置（生产环境必须使用强密钥）
SECRET_KEY=${SECRET_KEY}
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 数据库密码
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

# 外部服务API密钥（生产环境必填）
ZHIPU_API_KEY=${ZHIPU_API_KEY}
TWITTERAPI_IO_KEY=${TWITTERAPI_IO_KEY}
REDDIT_CLIENT_ID=${REDDIT_CLIENT_ID}
REDDIT_CLIENT_SECRET=${REDDIT_CLIENT_SECRET}
REDDIT_USERNAME=${REDDIT_USERNAME}
REDDIT_PASSWORD=${REDDIT_PASSWORD}

# Product Hunt API
PRODUCT_HUNT_CLIENT_ID=${PRODUCT_HUNT_CLIENT_ID}
PRODUCT_HUNT_CLIENT_SECRET=${PRODUCT_HUNT_CLIENT_SECRET}
PRODUCT_HUNT_REDIRECT_URI=https://yourdomain.com/auth/callback

# Stripe生产密钥
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}

# 安全配置
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# 性能配置
WORKERS=4
MAX_CONNECTIONS=1000
KEEP_ALIVE=2

# 监控配置
SENTRY_DSN=${SENTRY_DSN}
MONITORING_ENABLED=true