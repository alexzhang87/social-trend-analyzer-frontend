# ========================================
# 测试环境配置
# ========================================

# 应用配置
NODE_ENV=test
DEBUG=true
LOG_LEVEL=DEBUG

# 服务端口
FRONTEND_PORT=3001
BACKEND_PORT=8001

# 测试数据库配置
DATABASE_URL=sqlite:///./test.db
REDIS_URL=redis://localhost:6380/1

# API URLs
REACT_APP_API_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3001,http://localhost:8001

# JWT配置
SECRET_KEY=test-secret-key-not-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=15

# 测试用的模拟API密钥
ZHIPU_API_KEY=test_zhipu_key
TWITTERAPI_IO_KEY=test_twitter_key
REDDIT_CLIENT_ID=test_reddit_id
REDDIT_CLIENT_SECRET=test_reddit_secret
REDDIT_USERNAME=test_user
REDDIT_PASSWORD=test_pass

# Stripe测试密钥
STRIPE_SECRET_KEY=sk_test_test_key
STRIPE_PUBLISHABLE_KEY=pk_test_test_key
STRIPE_WEBHOOK_SECRET=whsec_test_secret

# 测试配置
TEST_MODE=true
MOCK_EXTERNAL_APIS=true
FAST_TESTS=true
SKIP_SLOW_TESTS=false

# 测试数据
TEST_DATA_PATH=./test_data
GENERATE_TEST_REPORTS=true
CLEANUP_AFTER_TESTS=true