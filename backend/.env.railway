# ========================================
# Railway 生产环境配置
# ========================================

# 应用配置
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# 管理员账号配置（强烈建议在Railway控制台中设置为安全值）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# 数据库配置（Railway会自动提供DATABASE_URL）
# DATABASE_URL 将由Railway自动设置
# 如果没有数据库服务，使用SQLite
DATABASE_URL=sqlite:///./app.db

# Redis配置（可选，Railway可以提供Redis服务）
# REDIS_URL 将由Railway自动设置，如果没有则使用内存缓存
REDIS_URL=

# JWT配置
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API密钥（需要在Railway控制台中设置）
# ZHIPU_API_KEY=
# TWITTERAPI_IO_KEY=
# OPENAI_API_KEY=

# CORS配置（Railway会提供域名）
CORS_ORIGINS=*

# 缓存配置
CACHE_TTL=3600
MAX_CACHE_SIZE=1000

# 数据收集配置
MAX_POSTS_PER_REQUEST=100
DEFAULT_ANALYSIS_DAYS=7

# 速率限制
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# 文件上传配置
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# 邮件配置（可选）
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# FROM_EMAIL=

# 监控配置
HEALTH_CHECK_INTERVAL=30
METRICS_ENABLED=true