# 🔑 IdeaEden 数据收集 API 配置模板
# 复制此文件为 .env 并填入你的API密钥

# ================================
# 🤗 Hugging Face 配置
# ================================
# 获取方式: https://huggingface.co/settings/tokens
# 免费注册即可获得，用于下载数据集
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ================================
# 📚 Stack Overflow 配置
# ================================
# Stack Exchange API (免费，有限制)
# 获取方式: https://stackapps.com/apps/oauth/register
STACK_EXCHANGE_KEY=your_stack_exchange_key_here

# ================================
# 🌐 Reddit 配置
# ================================
# 获取方式: https://www.reddit.com/prefs/apps
# 创建应用类型选择 "script"
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=IdeaEden_Data_Collector_v1.0

# ================================
# 🐦 Twitter 配置 (可选)
# ================================
# 获取方式: https://developer.twitter.com/
# 需要申请开发者账户
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret

# ================================
# 🚀 Product Hunt 配置
# ================================
# 获取方式: https://api.producthunt.com/v2/docs
# 免费注册即可获得
PRODUCT_HUNT_TOKEN=your_product_hunt_token

# ================================
# 📊 专业数据源配置 (可选)
# ================================
# CB Insights API (付费)
CB_INSIGHTS_API_KEY=your_cb_insights_key

# Crunchbase API (有免费额度)
CRUNCHBASE_API_KEY=your_crunchbase_key

# Alpha Vantage (金融数据，免费额度)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# ================================
# 🔍 搜索引擎配置 (可选)
# ================================
# Google Custom Search (免费额度)
GOOGLE_SEARCH_API_KEY=your_google_search_key
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id

# Bing Search API (免费额度)
BING_SEARCH_API_KEY=your_bing_search_key

# ================================
# 📈 数据质量配置
# ================================
# 数据质量阈值 (0.0-1.0)
MIN_QUALITY_SCORE=0.5

# 每个数据源的最大收集数量
MAX_RECORDS_PER_SOURCE=10000

# 数据收集间隔 (秒)
COLLECTION_INTERVAL=1

# ================================
# 💾 存储配置
# ================================
# 数据库路径
DATABASE_PATH=collected_data/collected_data.db

# 导出格式 (json, jsonl, csv)
EXPORT_FORMAT=jsonl

# 数据备份间隔 (小时)
BACKUP_INTERVAL=24

# ================================
# 🚨 安全配置
# ================================
# 是否启用数据加密
ENABLE_ENCRYPTION=false

# 加密密钥 (如果启用加密)
ENCRYPTION_KEY=your_encryption_key_here

# ================================
# 📝 使用说明
# ================================
# 1. 复制此文件为 .env
# 2. 填入相应的API密钥
# 3. 运行 python auto_data_collector.py --all
# 4. 查看 collected_data/ 目录下的结果

# ================================
# 🔗 获取API密钥的详细步骤
# ================================

# 🤗 Hugging Face Token:
# 1. 访问 https://huggingface.co/
# 2. 注册免费账户
# 3. 进入 Settings > Access Tokens
# 4. 创建新的 token (选择 Read 权限)
# 5. 复制 token 到上面的 HUGGINGFACE_TOKEN

# 📱 Reddit API:
# 1. 访问 https://www.reddit.com/prefs/apps
# 2. 点击 "Create App" 或 "Create Another App"
# 3. 选择 "script" 类型
# 4. 填写应用信息
# 5. 获取 client_id 和 client_secret

# 🚀 Product Hunt API:
# 1. 访问 https://api.producthunt.com/v2/docs
# 2. 注册 Product Hunt 账户
# 3. 创建新的应用
# 4. 获取 API token

# 📚 Stack Exchange API:
# 1. 访问 https://stackapps.com/apps/oauth/register
# 2. 注册应用
# 3. 获取 API key
# 4. 注意: 免费版本有调用限制

# 🐦 Twitter API (可选):
# 1. 访问 https://developer.twitter.com/
# 2. 申请开发者账户 (需要审核)
# 3. 创建应用
# 4. 获取 Bearer Token

# ================================
# 💡 免费额度说明
# ================================
# Hugging Face: 完全免费，无限制
# Reddit API: 免费，每分钟60次请求
# Product Hunt: 免费，每小时500次请求
# Stack Exchange: 免费，每天10000次请求
# Twitter API: 免费版本每月50万次请求
# Google Search: 免费，每天100次搜索
# Bing Search: 免费，每月1000次搜索

# ================================
# ⚠️ 注意事项
# ================================
# 1. 不要将 .env 文件提交到版本控制系统
# 2. 定期更新API密钥以确保安全
# 3. 遵守各平台的使用条款和限制
# 4. 合理控制请求频率，避免被限制
# 5. 某些API可能需要科学上网才能访问