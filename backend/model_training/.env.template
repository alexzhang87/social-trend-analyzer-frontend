# IdeaEden数据收集系统环境变量配置
# 请复制此文件为.env并填入真实的API密钥

# Reddit API配置
# 获取地址: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# GitHub API配置 (建议配置多个token以提高限制)
# 获取地址: https://github.com/settings/tokens
GITHUB_TOKEN_1=your_github_token_1_here
GITHUB_TOKEN_2=your_github_token_2_here
GITHUB_TOKEN_3=your_github_token_3_here
GITHUB_TOKEN_4=your_github_token_4_here
GITHUB_TOKEN_5=your_github_token_5_here

# Twitter API v2配置
# 获取地址: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Product Hunt API配置
# 获取地址: https://api.producthunt.com/v2/oauth/applications
PRODUCT_HUNT_CLIENT_ID=your_product_hunt_client_id_here
PRODUCT_HUNT_CLIENT_SECRET=your_product_hunt_client_secret_here

# 数据库配置
DATABASE_URL=postgresql://ideaeden:password@localhost:5432/ideaeden
REDIS_URL=redis://localhost:6379/0

# 数据收集配置
DAILY_TARGET_COUNT=5000  # 每日目标收集数量
MAX_STORAGE_DAYS=30      # 数据保存天数
QUALITY_THRESHOLD=0.6    # 质量分数阈值

# 云端部署配置
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# 监控配置
SENTRY_DSN=your_sentry_dsn_here
PROMETHEUS_PORT=9090

# 安全配置
SECRET_KEY=your_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com