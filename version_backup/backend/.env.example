# ========================================
# 社交趋势分析器 - 环境变量配置示例
# ========================================

# 数据库配置
DATABASE_URL=sqlite:///./app.db
REDIS_URL=redis://localhost:6379

# JWT认证
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM服务（智谱AI GLM-4.5）
ZHIPU_API_KEY=your_zhipu_api_key_here

# ========================================
# 社交媒体API配置
# ========================================

# Twitter API (继续使用 Twitter.io)
TWITTERAPI_IO_KEY=your_twitter_io_api_key_here

# Reddit 官方API
# 注册地址：https://www.reddit.com/prefs/apps
# ✅ 已注册成功！
REDDIT_CLIENT_ID=hH0BEEYddOeBpKMO-2GH_A
REDDIT_CLIENT_SECRET=2l2t5XyqAxIGSJMLLGAGjlct1DBmmA
REDDIT_USERNAME=your_reddit_username_here
REDDIT_PASSWORD=your_reddit_password_here

# Product Hunt 官方API
# 注册地址：https://api.producthunt.com/v2/oauth/applications
# ⚠️ 注意：重定向URI必须使用HTTPS
PRODUCT_HUNT_CLIENT_ID=your_product_hunt_client_id
PRODUCT_HUNT_CLIENT_SECRET=your_product_hunt_client_secret
PRODUCT_HUNT_REDIRECT_URI=https://your-ngrok-url.ngrok.io/auth/callback

# ========================================
# 应用商店API配置
# ========================================

# App Store Connect API (可选，仅用于开发者自己的应用)
# 注册地址：https://developer.apple.com/account/
APP_STORE_CONNECT_KEY_ID=your_key_id
APP_STORE_CONNECT_ISSUER_ID=your_issuer_id
APP_STORE_CONNECT_PRIVATE_KEY_PATH=path/to/private_key.p8

# Google Play Console API (可选，仅用于开发者自己的应用)
# 注册地址：https://console.developers.google.com/
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=path/to/service_account.json

# ========================================
# 第三方服务配置（可选）
# ========================================

# Apify (可选，用于高级数据抓取)
APIFY_API_TOKEN=your_apify_token_here

# SerpAPI (可选，用于搜索引擎数据)
SERPAPI_KEY=your_serpapi_key_here

# ========================================
# 代理配置（可选）
# ========================================
HTTP_PROXY=http://proxy:port
HTTPS_PROXY=http://proxy:port

# ========================================
# 应用配置
# ========================================
DEBUG=True
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8080